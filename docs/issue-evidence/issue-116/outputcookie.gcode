PRINT_START
;===== 预热热床和第一个挤出头 =================
M140 S70
M104 T3 S140

;===== 粗回零 =================
G28 X Y
T3
M109 T3 S140
G28 Z
G90
G0 Z10 F10000
MOVE_TO_DISCARD_FILAMENT_POSITION
M109 S170
ROUGHLY_CLEAN_NOZZLE_WITH_DISCARD
M104 S130
G4 P2000
ROUGHLY_CLEAN_NOZZLE
MOVE_TO_XY_IDLE_POSITION_EXTRUDER

;===== 检测钢板 =================
DETECT_BED_PLATE
MOVE_TO_XY_IDLE_POSITION_EXTRUDER

;===== 自动进料  ======================

SM_PRINT_AUTO_FEED EXTRUDER=2


SM_PRINT_AUTO_FEED EXTRUDER=3




;===== 挤出流量  ======================

SM_PRINT_FLOW_CALIBRATE INDEX=2 TARGET_TEMP=235


SM_PRINT_FLOW_CALIBRATE INDEX=3 TARGET_TEMP=220




;===== 取出第一个挤出头 =================
T3
SET_VELOCITY_LIMIT ACCEL=10000
M204 S10000

;===== 深度清洁喷嘴 =================
G90
G0 Z10 F10000
ROUGHLY_CLEAN_NOZZLE_WITH_DISCARD
G0 Z5 F10000
FINELY_CLEAN_NOZZLE_STAGE_1
G0 Z5 F10000
ROUGHLY_CLEAN_NOZZLE
G0 Z5 F10000
FINELY_CLEAN_NOZZLE_STAGE_2
M83

;===== 第一个挤出头降温 =================
M109 S130
M190 S70
M106 S0
G90
G0 Z5 F10000
MOVE_TO_DISCARD_FILAMENT_POSITION
INNER_CUTOFF_BASE_DISCARD
INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD
INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD
MOVE_TO_XY_IDLE_POSITION_EXTRUDER

